# Minecraft version the test server builds with BuildTools (26.x needs the Java 25 image in the Dockerfile)
MINECRAFT_VERSION=26.3

# Operator user UUID, name, and level
OPERATOR_UUID=
OPERATOR_NAME=
OPERATOR_LEVEL=4

# Whether to overwrite existing server
OVERWRITE_EXISTING_SERVER=false

# Keep usage reporting off on a development server
TRACE_USAGE_REPORTING=off
